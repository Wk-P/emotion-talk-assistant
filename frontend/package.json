{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "npm run build-only && wrangler dev",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "deploy": "npm run build-only && wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.134.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
